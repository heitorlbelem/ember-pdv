{
  "name": "mobile",
  "version": "1.0.0",
  "description": "Cliente mobile do Ember PDV",
  "main": "index.ts",
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": "22.23.4"
  },
  "dependencies": {
    "expo": "~58.0.23",
    "expo-build-properties": "~58.0.12",
    "expo-dev-client": "~58.0.18",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "dev": "expo start --dev-client",
    "android": "expo run:android",
    "android:build": "expo run:android",
    "android:device": "expo run:android --device",
    "ios": "expo run:ios",
    "ios:build": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "lint": "eslint .",
    "build:development": "npx eas-cli@latest build --platform all --profile development",
    "build:ios-simulator": "npx eas-cli@latest build --platform ios --profile development-simulator"
  },
  "private": true
}
